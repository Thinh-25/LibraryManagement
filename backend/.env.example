# Use the same credentials as the root .env. URL-encode special characters.
DATABASE_URL=postgresql+psycopg://library_app:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/library_management
CORS_ORIGINS=["http://localhost:5000"]
# Generate a unique random secret of at least 32 characters; never use this placeholder.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=30
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=300
RESERVATION_HOLD_HOURS=48
# Optional absolute directory for book covers; default: project .local/uploads/covers.
# COVER_UPLOAD_DIR=D:/LibraryManagement/.local/uploads/covers
